rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasAll(['merchant', 'nominalStr', 'dateTime', 'category', 'source', 'numericNominal'])
        && d.keys().hasOnly(['merchant', 'nominalStr', 'dateTime', 'category', 'source', 'numericNominal', 'paymentMethod', 'type'])
        && (!('type' in d) || d.type in ['expense', 'income'])
        && (!('paymentMethod' in d) || d.paymentMethod in ['QRIS', 'Transfer', 'VA', 'Cash', 'PayLater'])
        && d.merchant is string && d.merchant.size() <= 2000
        && d.nominalStr is string && d.nominalStr.size() <= 200
        && d.dateTime is timestamp
        && d.category is string && d.category.size() <= 200
        && d.source is string && d.source.size() <= 200
        && d.numericNominal is number && d.numericNominal >= 0 && d.numericNominal <= 1000000000000000;
    }
    function positiveAmount(value) {
      return value is number && value > 0 && value <= 1000000000000000;
    }
    function validActivity() {
      let d = request.resource.data;
      return (!('installedAt' in d) || d.installedAt is timestamp)
        && (!('lastOpenedAt' in d) || d.lastOpenedAt is timestamp)
        && (!('deletedAt' in d) || d.deletedAt == null);
    }
    function validAvatar() {
      let d = request.resource.data;
      return !('avatarCode' in d)
        || (d.avatarCode is int && d.avatarCode >= 1 && d.avatarCode <= 6);
    }
    match /users/{uid} {
      allow get, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['email', 'displayName', 'providers', 'plan', 'createdAt', 'lastLoginAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'providers', 'plan', 'createdAt', 'lastLoginAt', 'installedAt', 'lastOpenedAt', 'deletedAt', 'avatarCode'])
        && validActivity()
        && validAvatar()
        && request.resource.data.plan == 'free'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.providers is list
        && (!('lastOpenedAt' in request.resource.data) || request.resource.data.lastOpenedAt == request.time)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'providers', 'lastLoginAt', 'installedAt', 'lastOpenedAt', 'deletedAt', 'avatarCode'])
        && validActivity()
        && validAvatar()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastOpenedAt']) || request.resource.data.lastOpenedAt == request.time)
        && (!('installedAt' in resource.data) || request.resource.data.installedAt == resource.data.installedAt)
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.providers is list
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastLoginAt']) || request.resource.data.lastLoginAt == request.time);
    }
    match /users/{uid}/installations/{id} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['installedAt', 'deletedAt', 'lastOpenedAt'])
        && request.resource.data.keys().hasOnly(['installedAt', 'deletedAt', 'lastOpenedAt'])
        && request.resource.data.installedAt is timestamp
        && request.resource.data.deletedAt == null
        && request.resource.data.lastOpenedAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOpenedAt'])
        && request.resource.data.lastOpenedAt == request.time;
    }
    match /users/{uid}/transactions/{id} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validTransaction();
    }
    match /users/{uid}/settings/budget {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['daily', 'weekly', 'monthly'])
        && request.resource.data.keys().hasOnly(['daily', 'weekly', 'monthly', 'categories'])
        && (!('categories' in request.resource.data)
          || (request.resource.data.categories is list
            && request.resource.data.categories.size() > 0
            && request.resource.data.categories.size() <= 8
            && request.resource.data.categories.toSet().size() == request.resource.data.categories.size()
            && request.resource.data.categories.hasOnly(['Jajan', 'Makanan', 'Minuman', 'Belanja', 'Tagihan & Pulsa', 'Lifestyle', 'Transportasi', 'Umum'])))
        && positiveAmount(request.resource.data.daily)
        && positiveAmount(request.resource.data.weekly)
        && positiveAmount(request.resource.data.monthly);
    }
    match /users/{uid}/imports/{id} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['completed'])
        && request.resource.data.completed == true;
    }
  }
}
